# Both optional. With neither set, ScribeAI runs in mock mode (no network calls).
# Pick a provider explicitly (gemini | groq | mock); otherwise auto-detects by which key is present.
LLM_PROVIDER=
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
