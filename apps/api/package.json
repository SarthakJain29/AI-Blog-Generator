{
    "name": "@my-scope/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": ".dist/index.js",
    "scripts": {
        "dev": "dotenv -e ../../.env -- nodemon --watch src --ext ts --exec \"tsup && node .dist/index.js\"",
        "build": "tsup",
        "start": "dotenv -e ../../.env -- node .dist/index.js",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "clean": "rm -rf .dist .turbo node_modules"
    },
    "dependencies": {
        "express": "^4.21.2",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "@my-scope/utils": "*",
        "@my-scope/db": "*"
    },
    "devDependencies": {
        "@my-scope/eslint-config": "*",
        "@my-scope/typescript-config": "*",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22",
        "eslint": "^9.17.0",
        "nodemon": "^3.1.11",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    }
}